sisescala:
  url: https://sisescala.maraba.pa.gov.br

# UM relogio nesta maquina. Remova a secao inteira (ou deixe comentada) para desativar
# `sync`/`heartbeat` nesta maquina. Para VARIOS relogios, use `dispositivos_rep` abaixo.
# id e token vem de Marcacoes > Dispositivos REP > (dispositivo) > Gerar token.
dispositivo_rep:
  id: "00000000-0000-0000-0000-000000000000"
  token: "cole-aqui-o-token-gerado-em-marcacoes-dispositivos-rep"
  endereco: "10.110.2.89"
  porta: 443
  usa_https: true
  usuario_rep: admin
  senha_rep: "senha-de-administrador-do-relogio"
  cert_fingerprint: ""   # opcional: sha256 hex do certificado do relogio, para pinning de TLS
  # Opcional - quanto esperar por get_afd.fcgi (SO por ele; as outras chamadas seguem em 30s,
  # para relogio fora do ar falhar rapido). Ausente ou 0 usa o padrao de 600s. Aumente so se o
  # log acusar "context deadline exceeded ... while reading body" na PRIMEIRA coleta de um
  # relogio com historico grande - o dia a dia e incremental e nao chega perto disso.
  timeout_afd_segundos: 0

# VARIOS relogios na mesma unidade, coletados por esta mesma maquina (ha unidades com 4).
# Mesmos campos da secao acima, mais um `nome` opcional que so' serve de rotulo em log e no menu
# da bandeja. As duas secoes podem coexistir - `dispositivo_rep` continua valendo porque todo
# config.yaml ja instalado em campo usa ela.
#
# Cada relogio tem id e TOKEN PROPRIOS: nao ha token "da unidade". E' o token que diz ao
# SisEscala de qual equipamento e' cada linha do AFD, e o id repetido aqui e recusado no
# carregamento do arquivo, de proposito - dois relogios com o mesmo id fariam a batida de um
# entrar como sendo do outro, sem erro nenhum aparecendo em lugar nenhum.
#
# dispositivos_rep:
#   - nome: "REP-iDClass-HMI-01"
#     id: "00000000-0000-0000-0000-000000000000"
#     token: "token-do-relogio-1"
#     endereco: "10.110.5.5"
#     porta: 443
#     usa_https: true
#     usuario_rep: admin
#     senha_rep: "senha-de-administrador-do-relogio-1"
#   - nome: "REP-iDClass-HMI-02"
#     id: "00000000-0000-0000-0000-000000000000"
#     token: "token-do-relogio-2"
#     endereco: "10.110.5.6"
#     porta: 443
#     usa_https: true
#     usuario_rep: admin
#     senha_rep: "senha-de-administrador-do-relogio-2"

# Presente se esta maquina TAMBEM abre a tela de presenca local (terminal). Remova a secao
# para desativar `terminal abrir`.
# id e token vem de Marcacoes > Terminais Locais > (terminal) > Gerar token.
terminal_local:
  id: "00000000-0000-0000-0000-000000000000"
  token: "cole-aqui-o-token-gerado-em-marcacoes-terminais-locais"

# Opcional - default e %PROGRAMDATA%\SisEscala\fila
# Dentro dele, cada relogio tem sua propria subpasta (o id do dispositivo): lote de um
# equipamento nunca pode ser reenviado com o token de outro.
fila:
  diretorio: ""
