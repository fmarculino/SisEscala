NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Assina o cookie de sessao do terminal local (/api/presenca-local/*). Sem isso a rota de
# ativacao falha explicitamente com 500 - nunca cai para um segredo fixo no codigo.
TERMINAL_LOCAL_SESSION_SECRET=generate-a-long-random-secret